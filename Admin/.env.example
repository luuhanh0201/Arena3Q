# Copy to .env. Local JSON needs no external service.
DATABASE_DRIVER=json
JSON_DB_PATH=.local/db.json
LOCAL_STORAGE_PATH=.local/storage
STORAGE_DRIVER=local
API_HOST=127.0.0.1
API_PORT=4000
ADMIN_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080
SESSION_HOURS=8760
COOKIE_SECURE=false

# Later: DATABASE_DRIVER=postgres after running npm run db:migrate.
DATABASE_URL=postgresql://arena3q:replace-this-password@localhost:5432/arena3q_admin
POSTGRES_USER=arena3q
POSTGRES_PASSWORD=replace-this-password
POSTGRES_DB=arena3q_admin

# Optional services/adapters. Empty URL means Redis is not used.
REDIS_URL=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# STORAGE_DRIVER=s3 uses signed URLs; upload/sync is not part of read-only P0.
# CDN_PUBLIC_BASE_URL=https://cdn.example.com/arena3q
