  m_Name: Story_Opening
  m_EditorClassIdentifier: Arena3Q.Data::Arena3Q.Data.StoryScript
  speakers:
  - speakerId: narrator
    displayName: 
    hero: {fileID: 0}
    isPlayerLord: 0
