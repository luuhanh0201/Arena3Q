# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated IDE / solution files
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
crashlytics-build.properties

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Burst / addressables generated
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS
.DS_Store
Thumbs.db
# Meshy downloads (FBX + 4K textures, ~100 MB each) are editor-only sources for Arena3Q > Render Prop Sprites;
# only the rendered sprites are committed. Listed after the *.meta rule so their .meta files are ignored too.
/[Aa]ssets/**/Meshy_AI_*

# AgentComms: tasks and reports are transient messages between agents; only the rules, status and folders are tracked.
/AgentComms/*/inbox/*
/AgentComms/*/outbox/*
!/AgentComms/*/inbox/.gitkeep
!/AgentComms/*/outbox/.gitkeep

# NghiemThu: acceptance packages for the user to check locally; only the README files are tracked (images are heavy).
/NghiemThu/**
!/NghiemThu/**/
!/NghiemThu/**/README.md

# Third-party store assets (e.g. Hovl Studio "Magic Effects FREE"): usable in the game under the Asset Store EULA but
# not to be redistributed, and this repository is public. Kept local; the game falls back to its own effects without them.
/[Aa]ssets/ThirdParty/
/[Aa]ssets/ThirdParty.meta

# UI handoff sources and long media stay local (user rule: code and small assets only).
/docs/UI/Arena3Q_UI_Handoff/Assets/
/docs/UI/Arena3Q_UI_Handoff/reference/source_images/
/Assets/Arena3Q/Art/UI/Startup/Video/*.mp4*
/Assets/Arena3Q/Art/UI/Startup/Video/*.ogg*
/AgentComms/codex/staging/ui-tools/
